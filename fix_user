#!/usr/bin/env python3
"""Fix user passwords and clean up database using SQLAlchemy

This script uses the application's SQLAlchemy session and operations
to avoid direct sqlite3 usage. It is safe to run against PostgreSQL
backends (Supabase) as long as `DATABASE_URL` in `config.py` is set.
"""

from datetime import datetime
import bcrypt

from database.connection import get_db_session
from database.operations import (
    get_user_by_username,
    create_user,
    update_user_status,
    delete_user,
)


def fix_users():
    db = get_db_session()
    try:
        print("=== Vernika User Password Fix (SQLAlchemy) ===\n")

        users_to_fix = [
            {'username': 'rajat', 'email': 'rajatsinghtomar15@gmail.com',
                'password': 'admin123', 'role_id': 1},
            {'username': 'tanu', 'email': 'tanusinghchauhan1999@gmail.com',
                'password': 'tanu123', 'role_id': 2},
        ]

        for user in users_to_fix:
            existing = get_user_by_username(db, user['username'])
            hashed = bcrypt.hashpw(
                user['password'].encode(), bcrypt.gensalt()).decode()

            if existing:
                existing.password_hash = hashed
                existing.status = 'active'
                db.commit()
                print(
                    f"✅ Updated password for: {user['username']} ({user['password']})")
            else:
                create_user(db, user['username'], user['email'],
                            user['password'], user['role_id'])
                print(
                    f"✅ Created user: {user['username']} ({user['password']})")

        # Remove test users (john_doe, jane_smith, mike_wilson, manager)
        test_users = ['john_doe', 'jane_smith', 'mike_wilson', 'manager']
        for username in test_users:
            u = get_user_by_username(db, username)
            if u:
                delete_user(db, u.id)
                print(f"🗑️  Removed test user: {username}")

        # Show final users
        print("\n=== Final Users in Database ===")
        users = db.query.__self__.query.get_bind()
        # Fallback: simple listing via raw query
        rows = db.execute(
            "SELECT id, username, email, role_id, status FROM users ORDER BY id").fetchall()
        for u in rows:
            role_name = {1: 'Admin', 2: 'HR Manager',
                         3: 'Manager', 4: 'Employee'}.get(u[3], 'Unknown')
            print(f"  ID:{u[0]} {u[1]} ({role_name}) - {u[4]}")

    except Exception as e:
        print(f"❌ Error: {e}")
    finally:
        try:
            db.close()
        except:
            pass


if __name__ == '__main__':
    fix_users()
