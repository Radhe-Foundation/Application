#!/usr/bin/env python3
"""Fix user passwords and clean up database"""

import sqlite3
import bcrypt
from datetime import datetime

conn = sqlite3.connect('vernika.db')
cursor = conn.cursor()

print("=== Vernika User Password Fix ===\n")

# Define the correct users with their roles and passwords
users_to_fix = [
    {'username': 'rajat', 'email': 'rajatsinghtomar15@gmail.com', 'password': 'admin123', 'role_id': 1},
    {'username': 'tanu', 'email': 'tanusinghchauhan1999@gmail.com', 'password': 'tanu123', 'role_id': 2},
]

for user in users_to_fix:
    # Check if user exists
    cursor.execute("SELECT id, username FROM users WHERE username = ?", (user['username'],))
    existing = cursor.fetchone()
    
    if existing:
        # Update password with bcrypt hash
        hashed = bcrypt.hashpw(user['password'].encode(), bcrypt.gensalt()).decode()
        cursor.execute(
            "UPDATE users SET password_hash = ?, status = 'active' WHERE username = ?",
            (hashed, user['username'])
        )
        print(f"✅ Updated password for: {user['username']} ({user['password']})")
    else:
        # Create user with proper hash
        hashed = bcrypt.hashpw(user['password'].encode(), bcrypt.gensalt()).decode()
        cursor.execute(
            "INSERT INTO users (username, email, password_hash, role_id, status, created_at) VALUES (?, ?, ?, ?, ?, ?)",
            (user['username'], user['email'], hashed, user['role_id'], 'active', datetime.now().isoformat())
        )
        print(f"✅ Created user: {user['username']} ({user['password']})")

conn.commit()

# Remove test users (john_doe, jane_smith, mike_wilson, manager)
test_users = ['john_doe', 'jane_smith', 'mike_wilson', 'manager']
for username in test_users:
    cursor.execute("DELETE FROM users WHERE username = ?", (username,))
    print(f"🗑️  Removed test user: {username}")

conn.commit()

# Show final users
print("\n=== Final Users in Database ===")
cursor.execute("SELECT id, username, email, role_id, status FROM users ORDER BY id")
for u in cursor.fetchall():
    role_name = {1: 'Admin', 2: 'HR Manager', 3: 'Manager', 4: 'Employee'}.get(u[3], 'Unknown')
    print(f"  ID:{u[0]} {u[1]} ({role_name}) - {u[4]}")

conn.close()
print("\n=== Done! ===")
