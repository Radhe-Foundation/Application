#!/usr/bin/env python3
"""Check and fix users in database"""

import sqlite3
import bcrypt

conn = sqlite3.connect('vernika.db')
cursor = conn.cursor()

# Check rajat and tanu
cursor.execute("SELECT id, username, email, password_hash, role_id FROM users WHERE username IN ('rajat', 'tanu')")
users = cursor.fetchall()
print("Existing users:")
for u in users:
    print(f"  ID:{u[0]} User:{u[1]} Role:{u[4]}")

# Check if password works
if users:
    stored = users[0]['password_hash']
    test = bcrypt.checkpw('admin123'.encode(), stored.encode() if isinstance(stored, str) else stored)
    print(f"\nPassword test for rajat with 'admin123': {test}")

conn.close()
